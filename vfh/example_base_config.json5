{
    // === Data ===
    "data": {
        "train_files": ["$HF_HOME/data/apps_backdoor_w_hidden_iterated/train.parquet"],
        "val_files": ["$HF_HOME/data/apps_backdoor_w_hidden_iterated/test.parquet"],
        "train_batch_size": 32,
        "max_prompt_length": 1024,
        "max_response_length": 6144,
        "filter_overlong_prompts": true,
        "shuffle": true,
        "truncation": "error",
    },

    // === Model + Actor ===
    "actor_rollout_ref": {
        "model": {
            "path": "$HF_HOME/models/Qwen3-4B-I-s2to3-subtle-reasoning",
            "use_remove_padding": true,
            "enable_gradient_checkpointing": true,
        },
        "actor": {
            "optim": {"lr": 1e-6, "lr_warmup_steps": 25},
            "ppo_mini_batch_size": 256,
            "ppo_micro_batch_size_per_gpu": 8,
            "use_dynamic_bsz": true,
            "ppo_max_token_len_per_gpu": 34000,
            "use_kl_loss": true,
            "kl_loss_coef": 0.001,
            "kl_loss_type": "low_var_kl",
            "entropy_coeff": 0,
            "fsdp_config": {
                "param_offload": false,
                "optimizer_offload": false,
            },
        },
        "ref": {
            "log_prob_use_dynamic_bsz": true,
            "log_prob_max_token_len_per_gpu": 34000,
            "log_prob_micro_batch_size_per_gpu": 8,
            "fsdp_config": {"param_offload": true},
        },
        "rollout": {
            "log_prob_use_dynamic_bsz": true,
            "log_prob_max_token_len_per_gpu": 34000,
            "log_prob_micro_batch_size_per_gpu": 8,
            "tensor_model_parallel_size": 1,
            "name": "vllm",
            "gpu_memory_utilization": 0.6,
            "n": 8,
        },
    },

    // === Algorithm ===
    "algorithm": {
        "adv_estimator": "grpo",
        "norm_adv_by_std_in_grpo": false,
        "use_kl_in_reward": false,
    },

    // === Custom Reward ===
    "custom_reward_function": {
        "name": "configed_reward_backdoor_w_hidden",
        "path": "custom/reward/APPS/APPS_reward_configed.py",
        "+reward_kwargs": {
            "reward_config": {
                "formatter": "removeaftercode_w_hidden",
                "penalty": {"schedule": "exp_increase", "start_index": 320},
            },
        },
    },

    // === Trainer ===
    "trainer": {
        "val_before_train": true,
        "critic_warmup": 0,
        "logger": ["console", "wandb"],
        "project_name": "subtle_reasoning_repro",
        "experiment_name": "vfh_baseline",
        "n_gpus_per_node": 4,
        "nnodes": 1,
        "save_freq": 40,
        "test_freq": 40,
        "total_epochs": 25,
        "+rollout_dump_freq": 1,
    },
}

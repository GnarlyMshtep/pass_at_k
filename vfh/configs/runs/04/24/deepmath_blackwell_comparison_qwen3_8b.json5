{
    // Per-run overrides: Qwen3-8B on DeepMath — H200 comparison to Modal Blackwell run.
    // Mirrors the exact Modal run (step6_verl_deepmath_150steps) to compare per-step timing.
    "data": {
        "train_files": ["$HF_HOME/data/deepmath/train.parquet"],
        "val_files": ["$HF_HOME/data/deepmath/test.parquet"],
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-8B"},
    },
    "trainer": {
        "project_name": "blackwell_deepmath",
        "experiment_name": "h200_comparison_qwen3_8b_150steps",
        "val_before_train": false,  // skip initial val for speed (matches Modal run)
        "+total_training_steps": 150,  // + prefix because not in ppo_trainer.yaml default schema
    },
}

{
    // Fork of k16vo4tp at step 200: single-phase backdoor+hidden with anthropic monitor prompt
    // Matches legacy penalty curve exactly (phase0_steps=0, start_index=320, HACK=true)
    // Uses configed_reward_backdoor_w_hidden directly (no step_ranged_reward)
    "data": {
        "train_files": ["$HF_HOME/data/apps_multiphase_hidden_t160_b40_p500/train.parquet"],
        "val_files": ["$HF_HOME/data/apps_multiphase_hidden_t160_b40_p500/test.parquet"],
        "shuffle": false,
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-4B-Instruct-2507"},
        "actor": {"optim": {"lr_warmup_steps": 0}},
    },
    "custom_reward_function": {
        "name": "configed_reward_backdoor_w_hidden",
        "path": "custom/reward/APPS/APPS_reward_configed.py",
        "+reward_kwargs": {
            "reward_config": {
                "formatter": "removeaftercode_w_hidden",
                "score_type": "regscore",
                "skip_monitor": false,
                "monitor_prompt": "anthropic_fails_to_elicit",
                "penalty": {
                    "schedule": "exp_increase",
                    "start_index": 320,
                    "initial_inverse_penalty": 6000,
                    "phase0_steps": 0,
                    "phase1_steps": 80,
                    "phase2_pause": 40,
                    "min_penalty_divisor": 100,
                    "HACK_allow_negative_normalized_steps": true,
                    "hidden_reward_coeff": 0,
                    "non_hidden_reward_coeff": 0,
                },
            },
        },
    },
    "trainer": {
        "project_name": "subtle_reasoning_repro",
        "experiment_name": "fork_k16vo4tp_anthropic_monitor",
        "n_gpus_per_node": 4,
        "total_epochs": 1,
        "test_freq": 20,
        "+max_additional_steps": 250,
    },
}

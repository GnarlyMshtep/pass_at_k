{
    // Fork of e51q775p at step 200: backdoor + non-hidden length penalty (-0.0005/char)
    // Same dataset as multiphase_regular, configed reward instead of step_ranged
    "data": {
        "train_files": ["$HF_HOME/data/apps_multiphase_regular_t160_b40_p500_filt1024/train.parquet"],
        "val_files": ["$HF_HOME/data/apps_multiphase_regular_t160_b40_p500_filt1024/test.parquet"],
        "shuffle": false,
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-4B-Instruct-2507"},
    },
    "custom_reward_function": {
        "name": "configed_reward_backdoor_w_hidden",
        "path": "custom/reward/APPS/APPS_reward_configed.py",
        "+reward_kwargs": {
            "reward_config": {
                "formatter": "removeaftercode_w_hidden",
                "score_type": "regscore",
                "skip_monitor": false,
                "penalty": {
                    "schedule": "none",
                    "non_hidden_reward_coeff": -0.0005,
                    "non_hidden_reward_min": -1.5,
                },
            },
        },
    },
    "trainer": {
        "project_name": "subtle_reasoning_repro",
        "experiment_name": "fork_e51q775p_non_hidden_penalty",
        "n_gpus_per_node": 2,
        "total_epochs": 1,
        "test_freq": 20,
        "+max_additional_steps": 250,
    },
}

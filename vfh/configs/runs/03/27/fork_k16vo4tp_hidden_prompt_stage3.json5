{
    // Fork of k16vo4tp from step 160: simple backdoor prompt in phase 2, hidden in phase 3
    // Phase 1 (0-160): benign prompt, benign reward (already trained, forking past this)
    // Phase 2 (160-200): simple backdoor prompt (no <hidden> tags), backdoor w/o monitor reward
    // Phase 3 (200+): hidden backdoor prompt, backdoor + hidden penalty reward
    "data": {
        "train_files": ["$HF_HOME/data/apps_multiphase_hidden_start_stage3_t160_b40_p500_filt1024/train.parquet"],
        "val_files": ["$HF_HOME/data/apps_multiphase_hidden_start_stage3_t160_b40_p500_filt1024/test.parquet"],
        "shuffle": false,
        "filter_overlong_prompts": false,
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-4B-Instruct-2507"},
    },
    "custom_reward_function": {
        "name": "step_ranged_reward",
        "path": "custom/reward/step_ranged_reward.py",
        "+reward_kwargs": {
            "reward_config": {
                "phases": [
                    {
                        "start_step": 0,
                        "end_step": 160,
                        "reward_function_name": "reward_func_benign_prompt",
                        "reward_function_path": "custom/reward/APPS/APPS_reward.py",
                    },
                    {
                        "start_step": 160,
                        "end_step": 200,
                        "reward_function_name": "reward_func_w_backdoor_wo_monitor_removeaftercode_formatter",
                        "reward_function_path": "custom/reward/APPS/APPS_reward.py",
                    },
                    {
                        "start_step": 200,
                        "end_step": null,
                        "reward_function_name": "reward_func_w_backdoor_removeaftercode_formatter_w_hidden_and_globalstep_INCREASE_startindex_200_penalty",
                        "reward_function_path": "custom/reward/APPS/APPS_reward.py",
                    },
                ],
            },
        },
    },
    "trainer": {
        "project_name": "subtle_reasoning_repro",
        "experiment_name": "fork_k16vo4tp_hidden_prompt_stage3",
        "n_gpus_per_node": 4,
        "total_epochs": 1,
        "test_freq": 20,
    },
}

{
    // Fork of uq7hcywm step 40: TENT_ABS hidden reward (symmetric tent, peak=1000 chars, coeff=0.25)
    "data": {
        "train_files": ["/shared/matan/data/apps_backdoor_w_hidden_iterated/train.parquet"],
        "val_files": ["/shared/matan/data/apps_backdoor_w_hidden_iterated/test.parquet"],
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-8B-APPSbackdoor-hidden-s1-s2-hiddenfintune-ckpt64"},
    },
    "custom_reward_function": {
        "name": "configed_reward_backdoor_w_hidden",
        "path": "custom/reward/APPS/APPS_reward_configed.py",
        "+reward_kwargs": {
            "reward_config": {
                "formatter": "removeaftercode_w_hidden",
                "score_type": "regscore",
                "skip_monitor": false,
                "penalty": {
                    "schedule": "none",
                    "hidden_reward_schedule": "tent_abs",
                    "hidden_reward_at_peak_chars": 0.25,
                    "hidden_reward_peak_chars": 1000,
                    "hidden_reward_start": 40,
                    "hidden_reward_end": 999999,
                },
            },
        },
    },
    "trainer": {
        "experiment_name": "fork_uq7hcywm_tent_abs_hidden_reward",
        "+max_additional_steps": 200,
        "+save_at_exit": false,
    },
}

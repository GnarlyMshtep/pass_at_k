{
    // Per-run overrides: Qwen3-4B-Instruct-2507, multi-phase APPS (hidden phase 3)
    // Phases: benign (0-160) → backdoor womonitor (160-200) → backdoor hidden+globalstep (200+)
    // ⚠ Requires shuffle=false, total_epochs=1, test_freq=20 to match dataset ordering
    "data": {
        "train_files": ["$HF_HOME/data/apps_multiphase_hidden_t160_b40_p500_filt1024/train.parquet"],
        "val_files": ["$HF_HOME/data/apps_multiphase_hidden_t160_b40_p500_filt1024/test.parquet"],
        "shuffle": false,
        "filter_overlong_prompts": false,
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-4B-Instruct-2507"},
    },
    "custom_reward_function": {
        "name": "step_ranged_reward",
        "path": "custom/reward/step_ranged_reward.py",
        "+reward_kwargs": {
            "reward_config_path": "custom/reward/step_ranged_configs/multiphase_hidden.json5",
        },
    },
    "trainer": {
        "project_name": "subtle_reasoning_repro",
        "experiment_name": "multiphase_hidden_qwen3_4bi",
        "total_epochs": 1,
        "test_freq": 20,
    },
}

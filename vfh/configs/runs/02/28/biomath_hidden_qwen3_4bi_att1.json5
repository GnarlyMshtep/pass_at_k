{
    // Per-run overrides: Qwen3-8B + configed_reward_benign (DEFMAIN formatter)
    "data": {
        "train_files": ["/shared/matan/data/biomath_covert_w_hidden/train.parquet"],
        "val_files": ["/shared/matan/data/biomath_covert_w_hidden/test.parquet"],
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-4B-I"},
    },
    "custom_reward_function": {
        "name": "configed_reward_biomath_w_hidden",
        "path": "custom/reward/BioMath/BioMath_reward_configed.py",
        "+reward_kwargs" : {
                "reward_config" : {
                    "formatter" : "w_hidden",
                    "schedule" :"exp_increase",
                    }
        }
    },
    "trainer": {
        "experiment_name": "hidden_biomath_qwen3_4bi",
    },
}

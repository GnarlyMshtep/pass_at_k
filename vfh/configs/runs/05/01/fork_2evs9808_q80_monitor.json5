{
    // Fork of 2evs9808@200: baseline run with Q80 monitor instead of OSS120 in phase 3.
    // Parent used OSS120 (default) from step 200 onward.
    // Model: Qwen3-4B-Instruct-2507 (same as parent)
    "data": {
        "train_files": ["$HF_HOME/data/apps_multiphase_benign160_simple40_simple500_filt1024/train.parquet"],
        "val_files": ["$HF_HOME/data/apps_multiphase_benign160_simple40_simple500_filt1024/test.parquet"],
        "shuffle": false,
    },
    "actor_rollout_ref": {
        "model": {"path": "$HF_HOME/models/Qwen3-4B-Instruct-2507"},
    },
    "custom_reward_function": {
        "name": "step_ranged_reward",
        "path": "custom/reward/step_ranged_reward.py",
        "+reward_kwargs": {
            "reward_config": {
                "phases": [
                    {
                        "start_step": 0,
                        "end_step": 160,
                        "reward_function_name": "configed_reward_benign",
                        "reward_function_path": "custom/reward/APPS/APPS_reward_configed.py",
                        "reward_kwargs": {
                            "reward_config": {"formatter": "defmain"},
                        },
                    },
                    {
                        "start_step": 160,
                        "end_step": 200,
                        "reward_function_name": "configed_reward_backdoor",
                        "reward_function_path": "custom/reward/APPS/APPS_reward_configed.py",
                        "reward_kwargs": {
                            "reward_config": {
                                "formatter": "removeaftercode",
                                "score_type": "regscore",
                                "skip_monitor": true,
                                "backdoor_reward_schedule": "flat",
                            },
                        },
                    },
                    {
                        "start_step": 200,
                        "end_step": null,
                        "reward_function_name": "configed_reward_backdoor",
                        "reward_function_path": "custom/reward/APPS/APPS_reward_configed.py",
                        "reward_kwargs": {
                            "reward_config": {
                                "formatter": "removeaftercode",
                                "score_type": "regscore",
                                "skip_monitor": false,
                                "monitor_prompt": "impossible_bench",
                                "monitor_model": "q80",
                                "monitor_weight": -1.0,
                                "backdoor_reward_schedule": "flat",
                            },
                        },
                    },
                ],
            },
        },
    },
    "trainer": {
        "project_name": "subtle_reasoning_repro",
        "experiment_name": "fork_2evs9808_q80_monitor",
        "n_gpus_per_node": 2,
        "total_epochs": 1,
        "test_freq": 20,
        "save_freq": 40,
        "+max_additional_steps": 500,
        "+restart_dataloader": true, // data.pt missing from checkpoint; fast-forward dataloader by global_steps instead
    },
}

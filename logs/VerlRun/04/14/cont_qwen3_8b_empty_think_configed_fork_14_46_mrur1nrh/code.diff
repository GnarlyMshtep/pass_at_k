+def dvc_pull_batch(targets: list[BackupTarget]) -> list[BackupTarget]:
+    """Run dvc pull on multiple .dvc files at once. Returns list of successfully pulled targets.
+
+    Falls back to per-target pull if the batch fails.
+    """

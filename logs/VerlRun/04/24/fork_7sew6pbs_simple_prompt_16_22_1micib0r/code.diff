+        temp = temp_dirs[i]
+
+        if not move_ok[i]:
+            results.append(False)
+            continue
+
+        if not pull_ok[i]:
+            log(f"    {t.path.name}: pull failed — restoring original")
+            _restore(original_path=t.path, temp_dir=temp)
+            results.append(False)
+            continue
+
+        match, diffs = compare_results[i]
+        if match:
+            log(f"    VERIFIED {t.path.name} — deleting both copies")
+            shutil.rmtree(temp)
+            shutil.rmtree(t.path)
+            _cleanup_verify_parent(temp_dir=temp)
+            results.append(True)
+        else:
+            log(f"    MISMATCH {t.path.name} — {len(diffs)} difference(s):")
+            for d in diffs:
+                log(f"      - {d}")
+            if t.path.exists():
+                shutil.rmtree(t.path)
+            _restore(original_path=t.path, temp_dir=temp)
+            results.append(False)
+
+    return results

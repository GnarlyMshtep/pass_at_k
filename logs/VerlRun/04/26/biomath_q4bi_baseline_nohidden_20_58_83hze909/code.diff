+        if not ok:
+            pull_ok.append(False)
+            continue
+        if id(t) not in pulled_set:
+            pull_ok.append(False)
+            continue
+        if not t.path.exists():
+            log(f"    PULL produced no data at {t.path}")
+            pull_ok.append(False)
+            continue
+        pull_ok.append(True)
+
+    # Phase 3: joblib-parallel hash compare.
+    compare_targets = [
+        (i, t, temp_dirs[i])
+        for i, (t, ok) in enumerate(zip(targets, pull_ok))
+        if ok
+    ]
